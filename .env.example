# 이 파일을 복사해 .env.local을 만든다 (.env.local은 GitHub에 올라가지 않는다)

# real: 백엔드에 머지·확인된 API(READY_APIS)는 실제로 호출하고 나머지는 mock으로 답한다. 로컬 개발 기본값.
#       백엔드는 `npm run backend`로 띄운다(Docker 필요).
# mock: 모든 API를 가짜 응답으로. 배포(Vercel)는 백엔드가 없어서 mock이다(값을 안 넣어도 mock).
VITE_API_MODE=real

# true일 때만 /dev/boards(보드 모아 보기)가 열린다. 배포(Vercel)에는 넣지 않는다.
VITE_SHOW_BOARDS=true
